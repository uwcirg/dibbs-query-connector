# Copy to .env and modify as necessary.
# Variables here are used for interpolation in docker-compose YAML files.
# https://docs.docker.com/compose/environment-variables/#the-env-file

BASE_DOMAIN=localtest.me

# Required on shared hosts; prefixes container names (e.g. myhost-dev-${USER})
COMPOSE_PROJECT_NAME=dibbs-dev

# Image tag overrides
# POSTGRES_IMAGE_TAG=alpine
# KEYCLOAK_IMAGE_TAG=26.6
# FLYWAY_IMAGE_TAG=11-alpine
# AIDBOX_IMAGE_TAG=stable
# QUERY_CONNECTOR_IMAGE_TAG=latest

# Optional: bind-mount repo and run Next.js dev server in container
# COMPOSE_FILE=docker-compose.yaml:docker-compose.dev.query-connector.yaml

# Uncomment when using development overrides above
# QUERY_CONNECTOR_CHECKOUT_DIR=../../../

# JVM workaround for some Apple Silicon hosts (leave empty on M3/M4)
JAVA_TOOL_OPTIONS=-XX:UseSVE=0
